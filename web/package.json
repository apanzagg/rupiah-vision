  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
