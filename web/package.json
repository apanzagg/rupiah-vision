{
  "name": "suararupiah",
  "private": true,
  "version": "1.0.0",
  "description": "SuaraRupiah: PWA pengenal nominal uang kertas Rupiah dengan keluaran suara untuk penyandang tunanetra",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
